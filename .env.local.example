# Resend (https://resend.com) — used by app/api/lead/route.ts to email new
# waitlist leads instantly. Without this set, leads still succeed on the
# client (queuePosition is still returned) — they just get console.log'd
# on the server instead of emailed. Fill this in once you've verified a
# sending domain in Resend.
RESEND_API_KEY=

# Where new-lead notification emails get sent. Defaults to 0meram95@gmail.com
# in code if you leave this unset.
LEAD_NOTIFICATION_EMAIL=0meram95@gmail.com

# The "from" address Resend sends as. Must be on a domain you've verified
# in your Resend account — you cannot send from an arbitrary address
# (including your own Gmail) until that domain is verified.
LEAD_FROM_EMAIL="LeakAudit Leads <leads@yourdomain.com>"
