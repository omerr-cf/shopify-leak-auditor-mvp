# Resend (https://resend.com) — used by app/api/lead/route.ts to email new
# waitlist leads instantly. Without this set, leads still succeed on the
# client (queuePosition is still returned) — they just get console.log'd
# on the server instead of emailed.
RESEND_API_KEY=

# Where new-lead notification emails get sent. Defaults to
# omerbussy1995@gmail.com in code if you leave this unset.
LEAD_NOTIFICATION_EMAIL=omerbussy1995@gmail.com

# The "from" address Resend sends as. Defaults to onboarding@resend.dev,
# which works with ZERO domain setup — but Resend restricts that shared
# testing domain to only send TO the exact email address your Resend
# account itself is registered under. If LEAD_NOTIFICATION_EMAIL above is
# a different address, sends will 403 (the app still won't break — it
# just falls back to logging the lead server-side instead of emailing it).
# Once you verify your own domain in the Resend dashboard, switch this to
# an address on that domain and you can send to any recipient.
LEAD_FROM_EMAIL="LeakAudit Leads <onboarding@resend.dev>"

# Shared secret to view captured leads at /api/leads?secret=YOUR_SECRET
# (Netlify Blobs storage). Leave unset to keep that endpoint disabled.
ADMIN_SECRET=
