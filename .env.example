# Copy this file to .env (or .env.local) and fill in real values.
# Both .env and .env.local are gitignored -- never commit real secrets.
# A variable already `export`ed in your shell always overrides these files.

# --- Discovery (smart_outbound_engine.mjs) ---
SERPER_API_KEY=your_serper_api_key_here
BRAVE_API_KEY=

# --- Sending (smart_outbound_engine.mjs --send / --test-email) ---
RESEND_API_KEY=re_your_resend_key_here
RESEND_FROM_EMAIL=LeakAudit <you@yourdomain.com>

# Required for --send / --test-email. Must be a REAL, working postal
# address (street address, USPS-registered P.O. Box, or a CMRA-registered
# private mailbox) -- CAN-SPAM requires this, and the script hard-refuses
# if this looks like an email address instead. Do not put a city/country
# name alone here -- that does not satisfy the requirement.
SENDER_PHYSICAL_ADDRESS=Your Name, P.O. Box 123, City, Country

# Optional -- where replies (including "Reply STOP" opt-outs) should go.
SENDER_REPLY_TO=
